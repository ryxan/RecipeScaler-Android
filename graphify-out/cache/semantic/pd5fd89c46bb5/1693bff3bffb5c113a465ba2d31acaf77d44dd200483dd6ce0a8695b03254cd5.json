{"nodes": [{"id": "docs_plan_roadmap", "label": "Phased roadmap (Phases 0-6), source of truth for progress", "file_type": "document", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_kitchenunit", "label": "KitchenUnit enum", "file_type": "code", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the stringly-typed ALL_UNITS Pair<String,String> catalogue with a typed enum carrying family (VOLUME/WEIGHT/COUNT), system (US/METRIC), and toBase conversion factors."}, {"id": "docs_plan_ingredient", "label": "Ingredient data class (rawQuantity, quantity: Double?, unit, name, note)", "file_type": "code", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rawQuantity stores what the user typed so it round-trips exactly; nullable quantity distinguishes unparseable from zero (fixes B9)."}, {"id": "docs_plan_recipe", "label": "Recipe data class (title, yieldAmount, yieldLabel, ingredients)", "file_type": "code", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_scalemode", "label": "ScaleMode sealed interface (ByYield, ByIngredient, ByFactor)", "file_type": "code", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_displaymode", "label": "DisplayMode enum (KITCHEN, KEEP_UNITS, DECIMAL)", "file_type": "code", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_scalerecipe", "label": "ScaleRecipe use case (factor + invoke)", "file_type": "code", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_kitchenformatter", "label": "KitchenFormatter (measurement display)", "file_type": "code", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the cup/Tbsp/tsp 'measures you actually scoop' breakdown but snaps to measurable amounts: half-tsp precision with quarter/eighth below 1 tsp, cup fractions, fewest-parts-then-fewest-scoops selection. Replaces whole-number rounding, fixing bugs B1-B7."}, {"id": "docs_plan_quantityparser", "label": "QuantityParser", "file_type": "code", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns Double? so parse failure is distinguishable from zero (B9); handles thousands separators (B8), ranges via low end + RANGE_LOW_END flag, Unicode fractions, and rejects NaN/Infinity/exponents/negatives."}, {"id": "docs_plan_recipeocrparser", "label": "RecipeOcrParser", "file_type": "code", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carried over as-is: pure Kotlin, heavily tested, isolated from ML Kit via the OcrLine adapter; also powers the free Paste-recipe-text feature through parse(rawText)."}, {"id": "docs_plan_accuracy_bugs", "label": "B1-B10 accuracy bugs (whole-number rounding in formatQuantity/formatOther)", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The legacy engine rounds to whole numbers, doubling leaveners (B1), printing 'pinch' for quarter tsp (B2), and mis-scaling pt/qt/gal/fl-oz/weights; several bugs are locked in by tests that must be rewritten to the new spec."}, {"id": "docs_plan_room_persistence", "label": "Room persistence (RecipeEntity/IngredientEntity, exportSchema, migrations)", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relational storage gives stable IDs, ordering, search, and rename-without-delete/insert; replaces the old single Base64/tab-delimited preference blob where name was the key."}, {"id": "docs_plan_autosave", "label": "Editor autosave (500ms debounce straight to Room)", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Save button and no draft table; an app-scoped coroutine survives leaving the screen. A new recipe isn't inserted until it has a title or ingredient; a session-created recipe emptied before exit is deleted."}, {"id": "docs_plan_undo_delete", "label": "Undoable delete via RecipeRepository.restore", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delete is undoable instead of confirmed: restore brings the recipe back with its original id and timestamps so it lands in the same list position; the editor saves pending edits first so Undo restores the latest version."}, {"id": "docs_plan_quick_scale", "label": "Quick scale scratch recipe", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A normal autosaved recipe pre-titled 'Quick scale' with the first qty field focused; only inserted once the user edits something, so backing out saves nothing."}, {"id": "docs_plan_cook_mode", "label": "Cook mode (strike-through rows, keep screen on)", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_unit_inference", "label": "Unit inference on name-field blur / IME Next", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_paste_import", "label": "Paste recipe text import", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_scale_view_inputs", "label": "Scale View inputs: Serves + Scale to fields with 1x-10x chips", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_scanimporter", "label": "ScanImporter orchestration", "file_type": "code", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On-device OCR first, AI retry on poor results, on-device fallback on AI network errors, paywall when free credits are gone; a credit is reserved before the AI call and refunded (once, NonCancellable) on every non-success."}, {"id": "docs_plan_ai_import", "label": "AI recipe import (FirebaseAiRecipeImporter via Firebase AI Logic / Gemini)", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_ai_quota", "label": "AI import quota (10 free lifetime + bonus credits + hidden Pro 30/day cap)", "file_type": "concept", "source_file": "docs/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_billing_pro", "label": "Pro via Play Billing 8 (pro_monthly + pro_lifetime)", "file_type": "concept", "source_file": "docs/plan.md", "source_