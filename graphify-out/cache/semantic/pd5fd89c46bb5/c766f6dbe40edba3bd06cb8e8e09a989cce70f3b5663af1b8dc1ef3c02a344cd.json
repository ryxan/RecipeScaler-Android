{"nodes": [{"id": "docs_rescale_ux_review_recipe_list", "label": "Recipe List screen", "file_type": "concept", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rescale_ux_review_editor", "label": "Recipe Editor screen", "file_type": "concept", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rescale_ux_review_scale_view", "label": "Scale View screen (the core screen)", "file_type": "concept", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rescale_ux_review_cook_mode", "label": "Cook mode", "file_type": "concept", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used at arm's length with messy hands, so it needs bigger type, visible checkboxes, and a scale control that stays reachable."}, {"id": "docs_rescale_ux_review_settings", "label": "Settings screen", "file_type": "concept", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rescale_ux_review_quick_scale", "label": "Quick scale feature (unlabeled lightning icon today)", "file_type": "concept", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_rescale_ux_review_nav_default", "label": "Recipe tap should open Scale View, not the Editor", "file_type": "rationale", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The main job is not the shortest path: a cook wants open recipe -> see scaled amounts -> cook, and routing 90% of opens through an edit form adds a needless step. Recommended: List tap -> Scale View with an Edit pencil action."}, {"id": "docs_rescale_ux_review_multiplier_chips", "label": "Multiplier chips (half/1x/2x/3x) + stepper on Scale View", "file_type": "concept", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Doubling/halving is the dominant use case; bare target-serving numbers read as multipliers with no unit, and typing on a decimal keypad is slower than a stepper."}, {"id": "docs_rescale_ux_review_ingredient_row", "label": "Editor ingredient row rework (multi-line name, font-scale responsive, real labels)", "file_type": "concept", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Biggest accessibility and data-entry problem in the app: name truncates at ~150-170dp, the three-across layout breaks at 200% font scale, and placeholder-only labels vanish once text is entered."}, {"id": "docs_rescale_ux_review_remove_edit_mode", "label": "Remove 'Edit ingredients' mode; swipe-to-delete + persistent drag handle", "file_type": "concept", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A mode toggle on a screen that is already editable is confusing; 'edit' really means reorder/remove. Swipe-to-delete with Undo matches the list pattern and frees a top-bar slot."}, {"id": "docs_rescale_ux_review_accessibility", "label": "Accessibility checklist (liveRegion, spoken fractions, 48dp targets, 200% font pass)", "file_type": "concept", "source_file": "docs/Rescale-UX-Review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": 