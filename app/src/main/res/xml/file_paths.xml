<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider path configuration for the recipe scan feature.

    cache-path maps to Context.getCacheDir(); the camera photo is written before
    launching TakePicture and deleted after OCR finishes, so it never occupies
    storage for long. The path attribute scopes the grant to that sub-directory.
-->
<paths>
    <cache-path
        name="recipe_scan_photos"
        path="recipe_scan/" />
</paths>
